const images = {"arcade_cover":{"src":"data:image/webp;base64,","alt":"별별오락실 타이틀 화면"},"arcade_home":{"src":"data:image/webp;base64,","alt":"별별오락실 메인 화면"},"arcade_customize":{"src":"data:image/webp;base64,","alt":"별별오락실 캐릭터 꾸미기 화면"},"arcade_library":{"src":"data:image/webp;base64,","alt":"별별오락실 게임 라이브러리"},"arcade_gameplay":{"src":"data:image/webp;base64,","alt":"과충전 발전소 플레이 화면"},"arcade_before":{"src":"data:image/webp;base64,","alt":"캐릭터 꾸미기 개선 전 화면"},"arcade_after":{"src":"data:image/webp;base64,","alt":"캐릭터 꾸미기 개선 후 화면"},"arcade_spec_1":{"src":"data:image/webp;base64,","alt":"기본 캐릭터 디자인 유지 조건과 작업 범위"},"arcade_spec_2":{"src":"data:image/webp;base64,","alt":"캐릭터 기본 구성과 적용 기준"},"arcade_mission_request":{"src":"data:image/webp;base64,","alt":"일일 미션 갱신과 보상 규칙을 정리한 협업 기록"},"arcade_hair_qa":{"src":"data:image/webp;base64,","alt":"헤어 실루엣과 의상 경계 개선을 위한 QA 기준"},"leave_title":{"src":"data:image/webp;base64,","alt":"남기지 마세요 타이틀 화면"},"leave_village":{"src":"data:image/webp;base64,","alt":"마을 탐색 화면"},"leave_photo":{"src":"data:image/webp;base64,","alt":"오래된 가족사진 조사 화면"},"leave_hypothesis":{"src":"data:image/webp;base64,","alt":"잠정 가설 화면"},"leave_deduction":{"src":"data:image/webp;base64,","alt":"추리 성공 화면"},"leave_notebook":{"src":"data:image/webp;base64,","alt":"조사 수첩과 진행도 화면"},"leave_hint":{"src":"data:image/webp;base64,","alt":"조사 수첩 힌트 화면"},"leave_ai_process":{"src":"data:image/webp;base64,","alt":"4방향 걷기 애니메이션 작업 요청 기록"},"leave_spritesheet":{"src":"data:image/webp;base64,","alt":"4방향 걷기 애니메이션 스프라이트 시트"},"leave_act2":{"src":"data:image/webp;base64,","alt":"제2막 사라진 이름 제작 과정 기록"},"leave_unity_error":{"src":"data:image/webp;base64,","alt":"Unity Animator 참조 오류와 패키지 확인 과정"},"leave_calendar_request":{"src":"data:image/webp;base64,","alt":"식단 기록 달력 요구사항과 화면 시안"},"leave_calendar_game":{"src":"data:image/webp;base64,","alt":"게임 내 식단 기록 달력 화면"},"leave_door_request":{"src":"data:image/webp;base64,","alt":"출입구 상호작용 규칙과 배경 이미지 수정 요구사항"},"leave_door_asset":{"src":"data:image/webp;base64,","alt":"출입구 주변 배경 AI 생성 시안"},"leave_door_game":{"src":"data:image/webp;base64,","alt":"출입구 조사 버튼이 적용된 게임 화면"}};
document.querySelectorAll('[data-img]').forEach(el=>{const key=el.dataset.img;if(images[key]){el.src=images[key].src;el.alt=images[key].alt||el.alt;}});
const box=document.getElementById('lightbox'), big=document.getElementById('lightboxImage');
document.querySelectorAll('.shot img,.project-cover img,.hero-art img').forEach(img=>img.addEventListener('click',()=>{big.src=img.src;big.alt=img.alt;box.classList.add('open');}));
function closeBox(){box.classList.remove('open');big.removeAttribute('src');}
document.getElementById('closeLightbox').addEventListener('click',closeBox);box.addEventListener('click',e=>{if(e.target===box)closeBox();});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeBox();});
</script>
</body></html>
